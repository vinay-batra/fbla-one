# ChapterPrep: environment variables
# Copy to .env.local and fill in real values. .env.local is gitignored.
# On Vercel, set the same names under Project Settings -> Environment Variables.

# Supabase (auth + database). Project URL and anon key from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only Supabase key. Required for the daily AI caps (lib/ai-quota.ts);
# without it the caps are silently off and only the burst limiter applies.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anthropic API key (server only). Powers practice tests, the answer check,
# the AI Judge and the chat. https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY

# Site owner email (public). Unlocks /app/admin for the confirmed account with
# this login email. Leave unset to disable admin.
# NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# Set to "on" once Supabase sends auth email through a real sender (custom SMTP,
# e.g. Resend). Until then the Forgot password screen says reset email is not
# available instead of promising an email that never arrives.
# NEXT_PUBLIC_AUTH_EMAILS=on

# Resend API key for app email (lib/email.ts, not wired up yet).
# RESEND_API_KEY=re_...

# Nightly database backup (.github/workflows/db-backup.yml) is a GitHub Actions
# SECRET, not an env var here, and the workflow refuses to run on a public repo
# because the dump would be downloadable by anyone.
# SUPABASE_DB_URL=postgresql://...
