# FBLA One — environment variables
# Copy to .env.local and fill in with real values from your Supabase project.
# .env.local is gitignored.

# Supabase (auth + database)
# Create a project at https://supabase.com, then copy the project URL + anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only Supabase key (for admin tasks, never expose to client).
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anthropic API key (server-only — powers AI Practice Test Generator)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY

# Cloudflare Turnstile site key (public; bot protection on /auth). Optional, but
# strongly recommended: email confirmation is disabled, so an unprotected signup
# can be scripted to mass-create accounts. After setting this, also enable Captcha
# protection in Supabase: Authentication -> Settings -> Enable Captcha + paste the
# Turnstile SECRET key there (the secret is NOT an env var here).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR-TURNSTILE-SITE-KEY
